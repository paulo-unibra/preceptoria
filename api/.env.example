TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
# Gere com: node ace generate:key
APP_KEY=

# Limite de tentativas de login: "database" (produção) ou "memory" (testes)
LIMITER_STORE=database

# Banco de dados: sqlite (padrão, desenvolvimento) ou pg (produção)
DB_CONNECTION=sqlite
# DB_FILENAME=tmp/db.sqlite3
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_DATABASE=preceptoria

# Pasta de arquivos privados (fotos). Padrão: storage/
# STORAGE_PATH=storage

# Administrador criado pelo seeder (sem ADMIN_PASSWORD, em produção é gerada uma senha aleatória)
# ADMIN_EMAIL=admin@preceptoria.local
# ADMIN_PASSWORD=
